{
  "name": "ascii-sky",
  "version": "0.1.0",
  "description": "A painted blue sky in ASCII on a canvas: clouds drift on the wind, the pointer stirs the air, and at night the stars twinkle.",
  "keywords": ["ascii", "ascii-art", "canvas", "sky", "clouds", "animation", "background", "hero", "react"],
  "license": "MIT",
  "author": "unvalley",
  "homepage": "https://github.com/unvalley/ascii-sky#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unvalley/ascii-sky.git"
  },
  "bugs": "https://github.com/unvalley/ascii-sky/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "assets"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc",
    "test": "node --test \"src/*.test.ts\"",
    "bench": "node scripts/bench.mjs",
    "dev": "vite demo",
    "build:demo": "vite build demo",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@10.14.0"
}
