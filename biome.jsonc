{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["*.json", "*.jsonc", "src/**", "scripts/**", "demo/**", "!demo/dist"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "preset": "all",
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "nursery": "error",
      "complexity": {
        "noExcessiveCognitiveComplexity": "off",
        "noExcessiveLinesPerFunction": "off",
        "noForEach": "off",
        "useMaxParams": "off"
      },
      "correctness": {
        "noReactNativeRawText": "off",
        "noSolidDestructuredProps": "off",
        "useQwikValidLexicalScope": "off"
      },
      "performance": {
        "useSolidForComponent": "off"
      },
      "style": {
        "noContinue": "off",
        "noExcessiveLinesPerFile": "off",
        "noHexColors": "off",
        "noIncrementDecrement": "error",
        "noTernary": "off",
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "test"
          }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useDestructuring": "error",
        "useExportsLast": "off"
      },
      "suspicious": {
        "noBitwiseOperators": "off",
        "noReactSpecificProps": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "linter": {
        "rules": {
          "nursery": {
            "noArrayForEach": "off",
            "noExcessiveStatementsPerFunction": "off",
            "noMapSpread": "off",
            "noUnusedClasses": "off",
            "useMathTrunc": "off",
            "useModernMathApis": "off",
            "usePackageJsonCpu": "off",
            "usePackageJsonEngines": "off",
            "useReactFunctionComponentDefinition": {
              "level": "error",
              "options": {
                "namedComponents": "arrowFunction"
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**", "demo/vite.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off",
            "noProcessGlobal": "off"
          },
          "performance": {
            "noAwaitInLoops": "off"
          },
          "style": {
            "noDefaultExport": "off",
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["src/react.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noInlineStyles": "off"
          }
        }
      }
    },
    {
      "includes": ["demo/react.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noJsxLiterals": "off"
          }
        }
      }
    }
  ]
}
