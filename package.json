{
  "name": "ascii-sky",
  "version": "0.1.0",
  "description": "A painted blue sky in ASCII on a canvas: clouds drift on the wind, the pointer stirs the air, and at night the stars twinkle.",
  "keywords": [
    "ascii",
    "ascii-art",
    "canvas",
    "sky",
    "clouds",
    "animation",
    "background",
    "hero",
    "react"
  ],
  "homepage": "https://github.com/unvalley/ascii-sky#readme",
  "bugs": "https://github.com/unvalley/ascii-sky/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unvalley/ascii-sky.git"
  },
  "license": "MIT",
  "author": "unvalley",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "bench": "node scripts/bench.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build demo",
    "check": "tsc",
    "dev": "vite demo",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "prepare": "tsc -p tsconfig.build.json",
    "test": "node --test \"src/*.test.ts\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.23.0"
}
